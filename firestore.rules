rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       HELPERS
       ===================================================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function email() {
      return request.auth.token.email != null
             ? request.auth.token.email.lower()
             : '';
    }

    // Check if the caller is an admin
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }

    // Super admin email — hamesha admin
    function isSuperAdmin() {
      return isSignedIn() && email() == 'fh87022@gmail.com';
    }

    // True if no admin exists yet (used for bootstrap)
    function noAdminExists() {
      return !exists(/databases/$(database)/documents/admins/$(uid()))
             && true; // real check needs a query — we'll rely on client + rules below
    }

    /* =====================================================
       USERS COLLECTION
       users/{uid}
       - Each user can read/write their own doc
       - Admins can read all user docs
       ===================================================== */
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId
                    && request.resource.data.uid == userId;
      allow delete: if isAdmin();
    }

    /* =====================================================
       ADMINS COLLECTION
       admins/{uid}
       - Any signed-in user can read (needed for admin check)
       - Only admins (or super admin) can create/delete
       - Bootstrap exception: if the doc being created is for
         the caller themselves AND their email is super-admin,
         allow it even without existing admin.
       ===================================================== */
    match /admins/{adminId} {
      // Read: anyone signed in (needed to check own admin status)
      allow read: if isSignedIn();

      // Super admin can always grant themselves
      allow create: if isSignedIn()
                    && adminId == uid()
                    && (
                      isAdmin()                 // existing admin grants
                      || isSuperAdmin()         // super admin self-grant
                    );

      // Admin can create any admin
      allow create: if isSignedIn() && isAdmin();

      // Update: admin only
      allow update: if isSignedIn() && isAdmin();

      // Delete: admin only, but NOT self if last admin
      // (client also enforces "last admin" rule)
      allow delete: if isSignedIn() && isAdmin();
    }

    /* =====================================================
       CONFIGS COLLECTION
       configs/{uid}
       - Owner only
       - Admins can read/write any config (for support)
       ===================================================== */
    match /configs/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow create, update: if isSignedIn() && (uid() == userId || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    /* =====================================================
       TRIPS COLLECTION
       trips/{tripId}
       - Owner can read/create/update/delete their own trips
       - Admins can read/delete all (for management)
       - Prevents cross-user access via uid field check
       ===================================================== */
    match /trips/{tripId} {
      // Read: own trips or admin
      allow read: if isSignedIn() && (
        resource.data.uid == uid() || isAdmin()
      );

      // Create: must set uid = caller's uid
      allow create: if isSignedIn()
                    && request.resource.data.uid == uid();

      // Update: only own trips (or admin)
      allow update: if isSignedIn() && (
        resource.data.uid == uid() || isAdmin()
      ) && request.resource.data.uid == resource.data.uid;

      // Delete: own trips (or admin)
      allow delete: if isSignedIn() && (
        resource.data.uid == uid() || isAdmin()
      );
    }

    /* =====================================================
       DENY EVERYTHING ELSE
       ===================================================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}